{
  "name": "vip-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node start.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "register-commands": "tsx src/discord/registerCommands.ts",
    "postinstall": "prisma generate && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
