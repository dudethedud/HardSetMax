// Migrations: `prisma migrate dev` locally, `prisma migrate deploy` in production.
// Never `migrate reset` or `db push` (CLAUDE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// One row for the server: where colour removals are logged.
model Settings {
  guildId      String  @id
  logChannelId String?
}

// Roles that make someone a repper (given by other bots for the server tag or
// .gg/femboii in their status). Having any one of them unlocks the colour menus.
model UnlockRole {
  roleId String @id
}

// One colour menu message: a banner, a heading and a dropdown of colour roles.
model ColourMenu {
  id         Int          @id @default(autoincrement())
  title      String
  emoji      String?
  // The banner image itself (Discord's attachment links expire), and its file name.
  banner     Bytes?
  bannerName String?
  position   Int
  // Where it's posted, once /colours post has run.
  channelId  String?
  messageId  String?
  colours    MenuColour[]
}

// A colour role in a menu. A role can only be in one menu.
model MenuColour {
  roleId   String     @id
  menuId   Int
  position Int
  menu     ColourMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

// Donations (Ko-fi, plus ones staff add by hand). Totals count donations since
// DonationSettings.periodStart, so /donations reset starts a new round without
// deleting history. Donor emails are never stored.
model Donation {
  id          Int      @id @default(autoincrement())
  // Ko-fi's message_id: the same donation is only ever counted once.
  kofiId      String?  @unique
  // The Discord member, when their donation code was in the Ko-fi message (or staff added it).
  userId      String?
  // Ko-fi name, or "Anonymous" when the donor chose private.
  displayName String
  amountCents Int
  currency    String
  isPublic    Boolean
  source      String // "kofi" | "manual"
  addedBy     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// A member's donation code, given by the Donate button, to paste into the Ko-fi message.
model DonationCode {
  code      String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

// The donation panel and fund for the server.
model DonationSettings {
  guildId        String    @id
  channelId      String?
  messageId      String?
  kofiUrl        String?
  fundName       String    @default("Giveaway fund")
  goalCents      Int?
  donorRoleId    String?
  periodStart    DateTime  @default(now())
}

// Images inside the donation panel's box, like the rules post: "top" and "bottom".
// Kept apart from DonationSettings so clicks don't load them; only drawing the panel does.
model DonationBanner {
  slot String @id // "top" | "bottom"
  name String
  data Bytes
}

// Donor tier roles: a member with at least minCents donated in total (all rounds)
// wears the highest tier they've reached. Set with /donations tier.
model DonationTier {
  roleId   String @id
  minCents Int
}

// ---- Christmas invite event (docs/SPEC.md §8) ----

// The event's state. startAt is set the first time the feature runs, so restarts don't move it.
model InviteEventState {
  guildId        String    @id
  startAt        DateTime
  /** Counting of new joins stopped (staff /invite-event freeze, or the end time). */
  frozenAt       DateTime?
  frozenPostedAt DateTime?
  finalPostedAt  DateTime?
  /** Weekly leaderboard posts so far (the next one is week weeklyPosts + 1), and the last one's Sunday. */
  weeklyPosts    Int       @default(0)
  lastWeeklyDay  String?
  lastEvaluatedAt DateTime?
  /** Everyone already in the server was saved as a known member (rule 4). */
  snapshotDone   Boolean   @default(false)
}

// One row per invitee: rejoins never count twice.
model InviteJoin {
  id               Int       @id @default(autoincrement())
  inviteeId        String    @unique
  inviteeName      String
  /** Who gets the credit; null for vanity, discovery or unknown joins. */
  inviterId        String?
  inviteCode       String?
  /** "invite" | "personal" | "vanity" | "discovery" | "unknown" */
  source           String
  joinedAt         DateTime
  leftAt           DateTime?
  accountCreatedAt DateTime
  defaultAvatar    Boolean   @default(false)
  isBot            Boolean   @default(false)
  /** They were in the server (or joined) before this join (rule 4). */
  rejoin           Boolean   @default(false)
  /** "pending" | "valid" | "invalid" | "left" | "disqualified" */
  status           String    @default("pending")
  invalidReason    String?
  /** When it first became valid: ties on the leaderboard go to whoever got there first. */
  validatedAt      DateTime?
  /** Staff override (/invite-event set-status): wins over the rules. */
  overrideStatus   String?
  overrideReason   String?
  overrideBy       String?

  @@index([inviterId])
  @@index([joinedAt])
}

// A member's personal invite link (/invite-link): joins through it are credited to them for sure.
model PersonalInvite {
  code      String   @id
  userId    String   @unique
  channelId String
  createdAt DateTime @default(now())
}

// Everyone seen in the server: the members present when the event started, and every join since (rule 4).
model KnownMember {
  userId      String   @id
  firstSeenAt DateTime
  /** "snapshot" | "join" */
  source      String
}

// Inviters staff disqualified: none of their invites count, now or later.
model DisqualifiedInviter {
  userId String   @id
  reason String
  byId   String
  at     DateTime @default(now())
}

// Alt/fraud flags posted to staff, so each is posted once.
model InviteFlag {
  key        String   @id
  inviterId  String
  reason     String
  inviteeIds String[]
  createdAt  DateTime @default(now())
}
