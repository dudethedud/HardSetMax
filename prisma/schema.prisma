// Migrations: `prisma migrate dev` locally, `prisma migrate deploy` in production.
// Never `migrate reset` or `db push` (CLAUDE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// One row per Discord server. Later phases add their settings here.
model GuildConfig {
  guildId     String   @id
  // IANA timezone for the server-day boundary (SPEC §2).
  timezone    String   @default("America/Edmonton")
  // Local time of day ("HH:mm") when a server-day starts.
  dayBoundary String   @default("00:00")

  // Activity tracking (SPEC §2). All configurable with /config set.
  windowDays           Int   @default(7)
  messageCooldownSec   Int   @default(60)
  minMessageLength     Int   @default(4)
  voiceWeight          Float @default(0.2)
  voiceDailyCapMinutes Int   @default(240)
  spamRepeatHistory    Int   @default(5)
  spamRepeatMinutes    Int   @default(10)
  spamRepeatSimilarity Float @default(0.8)
  spamMinDistinctChars Int   @default(3)
  spamBurstCount       Int   @default(8)
  spamBurstSeconds     Int   @default(30)
  spamBurstMuteMinutes Int   @default(10)

  // Newest audit log entry already scanned for timeouts (startup catch-up).
  timeoutAuditCursor String?

  // VIP reshuffle (SPEC §4). All configurable with /config set.
  vipSlots          Int    @default(10)
  vipBuffer         Int    @default(3)
  vipMinHoldDays    Int    @default(5)
  vipInactivityDays Int    @default(3)
  vipMinScore       Float  @default(20)
  timeoutBlockDays  Int    @default(3)
  vipColour         String @default("#F1C40F")

  // Discord IDs (not names), so renamed roles/channels keep working (SPEC §11).
  vipRoleId         String?
  levelRolesTopId   String? // highest bleed level role; VIP goes directly above it
  loungeCategoryId  String?
  loungeTextId      String?
  loungeVoiceId     String?
  announceChannelId String?
  modLogChannelId   String?

  // VIP polls (SPEC §5a).
  pollsChannelId String?
  pollsRoleId    String?
  pollsDailyCap  Int     @default(2)

  // VIP colours (SPEC §5): defaults are added once, so deleting them all sticks.
  coloursSeeded Boolean @default(false)

  // Crown (SPEC §6).
  crownRoleId String?
  crownColour String  @default("#FF00C8")

  // History badges (SPEC §7): defaults are added once, so deleting them sticks.
  badgesSeeded Boolean @default(false)

  // AI chat (SPEC §9a).
  aiEnabled         Boolean @default(true)
  mainChatChannelId String?
  aiPerUserLimit    Int     @default(3) // replies per person per minute

  // VIP and Crown perks.
  vipBoardChannelId String? // public VIP board panel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Text channel weight; 0 ignores the channel. Threads use their parent's weight.
model ChannelWeight {
  channelId String   @id
  weight    Float
  updatedAt DateTime @updatedAt
}

// Last display name seen, so logs and announcements can name people who left.
model MemberName {
  userId    String   @id
  name      String
  updatedAt DateTime @updatedAt
}

// One row per user per server-day (SPEC §2 "Score"). Counts only, never content.
model ActivityDay {
  userId           String
  serverDay        String // server-day key, YYYY-MM-DD
  messages         Int    @default(0)
  weightedMessages Float  @default(0)
  voiceMinutes     Int    @default(0)
  filteredMessages Int    @default(0)

  @@id([userId, serverDay])
  @@index([serverDay])
}

// Manual score corrections from /activity adjust.
model ActivityAdjustment {
  id        Int      @id @default(autoincrement())
  userId    String
  serverDay String
  amount    Float
  reason    String
  actorId   String
  createdAt DateTime @default(now())

  @@index([serverDay])
}

// Time someone spent in a voice channel. Minutes are counted separately, per minute.
model VoiceSession {
  id            Int       @id @default(autoincrement())
  userId        String
  channelId     String
  startedAt     DateTime  @default(now())
  lastHeartbeat DateTime  @default(now())
  endedAt       DateTime?

  @@index([endedAt])
}

// The bot's own timeout history (Discord only shows active timeouts).
// A timeout is identified by who and its scheduled end, which both the live member
// update and the audit log entry carry, so it's never saved twice.
model TimeoutEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  startedAt DateTime
  until     DateTime // scheduled end
  endedAt   DateTime // actual end: `until`, or earlier if removed
  source    String // "member-update" | "audit-log" | "startup"

  @@unique([userId, until])
  @@index([userId, endedAt])
}

enum JobStatus {
  running
  succeeded
  failed
}

// One row per scheduled job run; (job, period) is unique so a job can't run twice
// for the same period (SPEC §11).
model JobRun {
  id         Int       @id @default(autoincrement())
  job        String
  period     String
  status     JobStatus @default(running)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  detail     Json?

  @@unique([job, period])
}

// Admin actions and bot-made changes. Never holds message content.
model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  actorId  String?
  action   String
  targetId String?
  reason   String?
  data     Json?

  @@index([at])
}

// Current VIPs. The database is the source of truth; Discord roles are made to match.
model VipMember {
  userId  String   @id
  since   String // server-day key they got VIP (for the minimum hold)
  sinceAt DateTime @default(now())
  pinned  Boolean  @default(false)
}

// Every stretch of holding VIP. Pinning or unpinning splits a stint, so pinned
// time can be left out of history badges (SPEC §7).
model VipStint {
  id        Int       @id @default(autoincrement())
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  endReason String?
  pinned    Boolean   @default(false)

  @@index([userId])
  @@index([endedAt])
}

// Blocked from VIP until a time (/vip remove with block_days).
model VipBlock {
  userId    String   @id
  until     DateTime
  reason    String
  actorId   String
  createdAt DateTime @default(now())
}

// Members with any of these roles can't be VIP.
model StaffRole {
  roleId String @id
}

// Bot-posted messages with buttons/dropdowns, re-posted if deleted (SPEC §11).
model Panel {
  kind      String   @id
  channelId String
  messageId String
  updatedAt DateTime @updatedAt
}

// Colour choices for VIPs (SPEC §5). Each has its own role, above the VIP role.
model ColourOption {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  hex      String
  position Int     @default(0)
  roleId   String?

  choices UserColourChoice[]
}

// A VIP's last colour pick. Kept when VIP is lost, so it comes back with VIP.
model UserColourChoice {
  userId   String       @id
  optionId Int
  option   ColourOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

// Every poll posted in #polls (SPEC §5a). A deleted poll still counts.
model PollPost {
  id        Int      @id @default(autoincrement())
  userId    String
  messageId String   @unique
  serverDay String
  kind      String // "vip" (counts toward the cap) | "extra" (/polls unlock) | "staff"
  accepted  Boolean // false: over a limit, deleted
  createdAt DateTime @default(now())

  @@index([serverDay])
}

// A permission overwrite the bot put on #polls, removed once `until` passes.
// scope "user": a VIP's personal lock ("deny") or admin-granted extra poll ("allow").
// scope "role": the VIP role is locked because the daily cap was reached.
model PollLock {
  id        Int      @id @default(autoincrement())
  scope     String
  targetId  String
  effect    String // "deny" | "allow"
  serverDay String
  until     DateTime
  createdAt DateTime @default(now())

  @@unique([scope, targetId])
}

// One Crown per week (SPEC §6). Weeks run Monday to Sunday in server-days.
model CrownHolder {
  id        Int       @id @default(autoincrement())
  userId    String
  weekStart String    @unique // server-day key of the week's Monday
  awardedAt DateTime  @default(now())
  endedAt   DateTime?
  endReason String?
  // The Crown's one decree per week.
  decreeAt  DateTime?
  // The 👑 nickname prefix: their nickname before it, restored when the Crown ends.
  nickApplied Boolean @default(false)
  nickBefore  String?
}

// The three titles the Crown holder can hand out for their week. Cosmetic only:
// each is a role with no permissions.
model CrownTitle {
  slot        String    @id // "champion" | "advisor" | "jester"
  name        String
  roleId      String?
  holderId    String?
  appointedAt DateTime?
}

// One VIP shoutout per VIP per server-day. The text itself is never saved.
model Shoutout {
  userId    String
  serverDay String
  messageId String?
  createdAt DateTime @default(now())

  @@id([userId, serverDay])
}

// A Crown holder's custom role. Settings stay when the role is deleted, so it
// comes back if they win the Crown again.
model CustomRole {
  userId     String   @id
  name       String
  hex        String
  emoji      String?
  roleId     String?
  editsWeek  String? // week the edit count belongs to
  editsCount Int      @default(0)
  locked     Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

// Words a custom role name can't contain.
model BlockedWord {
  word String @id
}

// The last custom role form answers, so "Try again" can refill the form. Deleted
// after 15 minutes.
model ModalDraft {
  userId    String   @id
  data      Json
  expiresAt DateTime
}

// A VIP history milestone (SPEC §7), e.g. 4 weeks → "VIP Regular".
model Badge {
  id     Int     @id @default(autoincrement())
  weeks  Int     @unique
  name   String  @unique
  roleId String?

  earned UserBadge[]
}

// Badges are permanent: they stay after VIP is lost.
model UserBadge {
  userId    String
  badgeId   Int
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([awardedAt])
}

// A VIP's temporary voice channel (SPEC §8). One per VIP; deleted after 60 s empty.
model TempVoiceChannel {
  channelId  String    @id
  ownerId    String    @unique
  createdAt  DateTime  @default(now())
  emptySince DateTime? // null while someone is in it
}

// An AI provider in the chain (SPEC §9a). Adding one is a row plus an env var.
model AiProvider {
  name          String    @id
  baseUrl       String // OpenAI-compatible; {ENV_VAR} placeholders are filled from the environment
  model         String
  keyEnvVar     String // name of the env var holding the API key (never the key itself)
  dailyCap      Int
  resetTimezone String    @default("UTC") // when this provider's daily limit resets
  order         Int
  enabled       Boolean   @default(true)
  cooldownUntil DateTime?
  lastError     String?
}

// Replies per provider per provider-day. provider "prewritten" counts fallbacks.
model AiUsage {
  provider    String
  providerDay String
  count       Int    @default(0)

  @@id([provider, providerDay])
}
