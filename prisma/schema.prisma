// Migrations: `prisma migrate dev` locally, `prisma migrate deploy` in production.
// Never `migrate reset` or `db push` (CLAUDE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// One row for the server: where colour removals are logged.
model Settings {
  guildId      String  @id
  logChannelId String?
}

// Roles that make someone a repper (given by other bots for the server tag or
// .gg/femboii in their status). Having any one of them unlocks the colour menus.
model UnlockRole {
  roleId String @id
}

// One colour menu message: a banner, a heading and a dropdown of colour roles.
model ColourMenu {
  id         Int          @id @default(autoincrement())
  title      String
  emoji      String?
  // The banner image itself (Discord's attachment links expire), and its file name.
  banner     Bytes?
  bannerName String?
  position   Int
  // Where it's posted, once /colours post has run.
  channelId  String?
  messageId  String?
  colours    MenuColour[]
}

// A colour role in a menu. A role can only be in one menu.
model MenuColour {
  roleId   String     @id
  menuId   Int
  position Int
  menu     ColourMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

// Donations (Ko-fi, plus ones staff add by hand). Totals count donations since
// DonationSettings.periodStart, so /donations reset starts a new round without
// deleting history. Donor emails are never stored.
model Donation {
  id          Int      @id @default(autoincrement())
  // Ko-fi's message_id: the same donation is only ever counted once.
  kofiId      String?  @unique
  // The Discord member, when their donation code was in the Ko-fi message (or staff added it).
  userId      String?
  // Ko-fi name, or "Anonymous" when the donor chose private.
  displayName String
  amountCents Int
  currency    String
  isPublic    Boolean
  source      String // "kofi" | "manual"
  addedBy     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// A member's donation code, given by the Donate button, to paste into the Ko-fi message.
model DonationCode {
  code      String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

// The donation panel and fund for the server.
model DonationSettings {
  guildId        String    @id
  channelId      String?
  messageId      String?
  kofiUrl        String?
  fundName       String    @default("Giveaway fund")
  goalCents      Int?
  donorRoleId    String?
  periodStart    DateTime  @default(now())
}
