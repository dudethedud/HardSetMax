DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Supabase "Session pooler" string + ?sslmode=require (docs/OPERATIONS.md).
# For a local database: postgresql://user:pass@localhost:5432/vipbot
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Path to Supabase's SSL certificate (CA). Not needed for a local database.
DATABASE_CA_CERT=certs/supabase-ca.crt
# Optional: Prisma connection pool size (default 5).
DATABASE_POOL_MAX=5

LOG_LEVEL=info

# Phase 9 (AI chat)
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
