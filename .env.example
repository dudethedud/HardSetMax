DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Supabase "Session pooler" string + ?sslmode=require (docs/OPERATIONS.md).
# For a local database: postgresql://user:pass@localhost:5432/colours
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Path to Supabase's SSL certificate (CA). Not needed for a local database.
DATABASE_CA_CERT=certs/supabase-ca.crt
# Optional: Prisma connection pool size (default 5).
DATABASE_POOL_MAX=5

LOG_LEVEL=info

# Donations (optional): Ko-fi → More → API → Verification Token, and the port Ko-fi
# should reach (on Wispbyte, the number after the colon in the server's address).
KOFI_VERIFICATION_TOKEN=
WEBHOOK_PORT=

# Christmas invite event (optional, docs/SPEC.md §8): on when both of these are set.
LEADERBOARD_CHANNEL_ID=
LEVEL3_ROLE_ID=
# End, Edmonton time (default 2026-12-25T12:00).
INVITE_EVENT_END=2026-12-25T12:00
# Alt flags and staff changes (default: the /colours log channel).
STAFF_LOG_CHANNEL_ID=
# Where /invite-link makes personal invites (default: the leaderboard channel).
INVITE_LINK_CHANNEL_ID=
EMBED_COLOR=#a8d8f0

# Check-in DMs for quiet members (docs/SPEC.md §9): on by default; "off" sends none.
CHECKIN_DMS=on
